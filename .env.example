KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce_events
EVENTS_PER_SECOND=5

BRONZE_PATH=data/bronze/events
SILVER_EVENTS_PATH=data/silver/events
SILVER_METRICS_PATH=data/silver/metrics

BRONZE_CHECKPOINT=data/checkpoints/bronze_events
SILVER_EVENTS_CHECKPOINT=data/checkpoints/silver_events
SILVER_METRICS_CHECKPOINT=data/checkpoints/silver_metrics

WATERMARK_DELAY=10 minutes
WINDOW_DURATION=5 minutes
